{
  "name": "hazlo-sano",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "emulators": "firebase emulators:start --project healthy-food-habits --import=firebase-exported",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "format": "biome check --write  .",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:run": "playwright test",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:run:local": "vitest --run --mode test",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "prepare": "husky",
    "validate": "biome check . && pnpm run typecheck && pnpm run test:run",
    "backfill-embeddings": "tsx src/scripts/backfillEmbeddings.ts",
    "backfill-translations": "tsx src/scripts/backfillTranslations.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:products": "tsx src/scripts/seedHazloSanoProducts.ts",
    "import:catalog": "tsx src/scripts/importSupplierCatalog.ts",
    "seed:demo-seller": "tsx src/scripts/seedDemoSeller.ts",
    "migrate:products": "tsx src/scripts/migrateProductsToPosts.ts",
    "verify:embedding-space": "tsx src/scripts/verifyEmbeddingSpace.ts",
    "check:i18n": "tsx src/scripts/checkI18n.ts",
    "check:directives": "tsx src/scripts/checkDirectives.ts",
    "seed:pillar-subcategories": "tsx src/scripts/seedPillarSubcategories.ts",
    "seed:home-care-categories": "tsx src/scripts/seedHomeAndCareCategories.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@google-cloud/aiplatform": "^6.0.0",
    "@next/third-parties": "16.2.1",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-avatar": "^1.1.9",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-navigation-menu": "^1.2.12",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "file-type": "^21.0.0",
    "firebase": "^10.14.0",
    "firebase-admin": "^13.6.0",
    "leaflet": "^1.9.4",
    "next": "16.2.1",
    "next-auth": "^5.0.0-beta.20",
    "next-intl": "^4.1.0",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.0.1",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tiny-invariant": "^1.3.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@chromatic-com/storybook": "^5.1.1",
    "@faker-js/faker": "^9.7.0",
    "@playwright/test": "^1.43.1",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/addon-links": "^10.3.3",
    "@storybook/nextjs-vite": "10.3.3",
    "@storybook/react": "^10.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/leaflet": "^1.9.22",
    "@types/next-auth": "^3.15.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.0.11",
    "jsdom": "^24.0.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.35",
    "sharp": "^0.35.3",
    "storybook": "^10.3.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vite": "^7.0.0",
    "vitest": "^1.3.1"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
